{
  "schemaVersion": 1,
  "id": "snakex",
  "version": "${version}",
  "name": "SnakeX Client",
  "description": "A sleek green & black Fabric client.",
  "authors": [
    "Jules"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/fabricmc/fabric-example-mod"
  },
  "license": "MIT",
  "icon": "assets/snakex/icon.png",
